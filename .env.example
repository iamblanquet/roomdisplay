# ============================================================
# ROOM DISPLAY KIOSK - VARIABLES DE ENTORNO
# ============================================================

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Modo Demostración (true = usar datos simulados sin conectar a Azure)
DEMO_MODE=true

# Microsoft Entra ID (Azure AD) - App Registration (Client Credentials)
# Requerido si DEMO_MODE=false
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Sala por defecto si no se pasa ?room= en la URL
DEFAULT_ROOM_EMAIL=sala-juntas@empresa.com
DEFAULT_ROOM_NAME=Sala de Juntas Principal

# Caché en segundos para llamadas a Microsoft Graph (por defecto: 60)
CACHE_TTL_SECONDS=60

# Zona Horaria (ej. America/Mexico_City, America/Bogota, UTC)
TIMEZONE=America/Mexico_City

# Contraseña / PIN de acceso a la configuración administrativa del Kiosk (ej. 1234)
ADMIN_PIN=1234
